{
  "name": "nado-trading-desk",
  "private": true,
  "repository": { "type": "git", "url": "git+https://github.com/juu17/nado-trading-desk.git" },
  "homepage": "https://github.com/juu17/nado-trading-desk",
  "bugs": { "url": "https://github.com/juu17/nado-trading-desk/issues" },
  "packageManager": "pnpm@11.9.0",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "eslint packages",
    "test": "vitest run",
    "redaction:gate": "node scripts/redaction-gate.mjs --enforce",
    "redaction:selftest": "node scripts/redaction-gate.mjs --selftest",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "devDependencies": {
    "turbo": "2.1.3",
    "typescript": "5.6.3",
    "eslint": "9.13.0",
    "typescript-eslint": "8.10.0",
    "vitest": "2.1.5"
  }
}
